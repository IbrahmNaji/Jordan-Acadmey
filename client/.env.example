# Base URL of the API server (include the /api suffix)
VITE_API_URL=http://localhost:4000/api

# Public website origin used for canonical metadata and the sitemap (set the real HTTPS domain in production)
VITE_SITE_URL=https://example.com

# Public contact details rendered on the marketing pages
VITE_ACADEMY_PHONE=""
VITE_ACADEMY_WHATSAPP=""
VITE_ACADEMY_EMAIL=""
VITE_ACADEMY_INSTAGRAM=""

# Currency label shown next to monetary amounts (defaults to ل.س)
VITE_CURRENCY_LABEL=""
