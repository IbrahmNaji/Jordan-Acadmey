generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role      @default(AGENT)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedLeads Lead[]         @relation("assignedLeads")
  activities    Activity[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([role])
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model CampaignSource {
  id          String   @id @default(uuid())
  name        String   @unique
  channel     Channel
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]

  @@index([channel])
  @@index([isActive])
}

enum Channel {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  PHONE
  WALK_IN
  REFERRAL
  GOOGLE_ADS
  OTHER
}

model Lead {
  id              String         @id @default(uuid())
  fullName        String
  phone           String
  whatsapp        String?
  email           String?
  city            String?        @default("دمشق")
  age             Int?
  interestedIn    CourseType?
  sourceId        String?
  source          CampaignSource? @relation(fields: [sourceId], references: [id])
  status          LeadStatus     @default(NEW)
  assignedToId    String?
  assignedTo      User?          @relation("assignedLeads", fields: [assignedToId], references: [id])
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notes           String?
  nextFollowUpAt  DateTime?
  lastContactedAt DateTime?
  convertedAt     DateTime?
  lostReason      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  enrollment Enrollment?
  activities Activity[]
  consents   ConsentRecord[]

  @@index([status])
  @@index([nextFollowUpAt])
  @@index([assignedToId])
  @@index([phone])
  @@index([createdAt])
  @@index([customerId])
}

enum CourseType {
  MECHANICS
  ELECTRICAL
  DIAGNOSTICS
  HYBRID
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  INTERESTED
  FOLLOW_UP
  ENROLLED
  LOST
  NOT_INTERESTED
}

model Enrollment {
  id          String           @id @default(uuid())
  leadId      String           @unique
  lead        Lead             @relation(fields: [leadId], references: [id])
  course      CourseType
  courseId    String?
  courseRef   Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batchId     String?
  batch       CourseBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  totalFee    Decimal          @db.Decimal(10, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(10, 2)
  paymentPlan String?
  startDate   DateTime?
  endDate     DateTime?
  status      EnrollmentStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payments   Payment[]
  attendance Attendance[]

  @@index([status])
  @@index([course])
  @@index([courseId])
  @@index([batchId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Payment {
  id           String        @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  note         String?
  paidAt       DateTime      @default(now())
  recordedById String?
  createdAt    DateTime      @default(now())

  @@index([enrollmentId])
  @@index([paidAt])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  SHAM_CASH
  OTHER
}

model Activity {
  id        String       @id @default(uuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      ActivityType
  content   String
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

enum ActivityType {
  CALL
  WHATSAPP_MSG
  NOTE
  STATUS_CHANGE
  FOLLOW_UP_SET
  ENROLLMENT
}

// Shared identity kept separate from any single business line. Leads,
// enrollments, deals, and work orders reference this record instead of
// duplicating contact data. Records are archived, never hard-deleted.
model Customer {
  id         String    @id @default(uuid())
  fullName   String
  phone      String?
  email      String?
  city       String?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contacts CustomerContact[]
  leads    Lead[]
  consents ConsentRecord[]

  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

enum ContactType {
  PHONE
  EMAIL
  WHATSAPP
  OTHER
}

model CustomerContact {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       ContactType
  value      String
  label      String?
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([customerId, type, value])
  @@index([value])
  @@index([customerId])
}

model ConsentRecord {
  id         String    @id @default(uuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  purpose    String
  version    String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
  source     String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([leadId])
  @@index([purpose])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  summary    String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String?
  link       String?
  entityType String?
  entityId   String?
  dedupeKey  String?   @unique
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Academy
// ---------------------------------------------------------------------------

model CourseCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@index([isActive])
}

model Instructor {
  id        String   @id @default(uuid())
  fullName  String
  specialty String?
  bio       String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]
  batches CourseBatch[]
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DeliveryMode {
  ONSITE
  ONLINE
  HYBRID
}

model Course {
  id            String       @id @default(uuid())
  slug          String       @unique
  title         String
  shortTitle    String
  courseType    CourseType
  categoryId    String?
  category      CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructorId  String?
  instructor    Instructor?  @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  tagline       String
  summary       String
  description   String[]
  focus         String[]
  prerequisites String[]     @default([])
  format        String
  note          String
  image         String
  imageAlt      String
  deliveryMode  DeliveryMode @default(ONSITE)
  price         Decimal?     @db.Decimal(12, 2)
  currency      String       @default("SYP")
  featured      Boolean      @default(false)
  sortOrder     Int          @default(0)
  status        CourseStatus @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  batches     CourseBatch[]
  enrollments Enrollment[]

  @@index([status])
  @@index([featured])
  @@index([courseType])
  @@index([categoryId])
}

enum BatchStatus {
  PLANNED
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

model CourseBatch {
  id           String        @id @default(uuid())
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code         String?
  title        String?
  startDate    DateTime?
  endDate      DateTime?
  capacity     Int?
  instructorId String?
  instructor   Instructor?   @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  status       BatchStatus   @default(PLANNED)
  deliveryMode DeliveryMode?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  enrollments Enrollment[]

  @@unique([courseId, code])
  @@index([courseId])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id           String           @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessionDate  DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([enrollmentId, sessionDate])
  @@index([sessionDate])
}