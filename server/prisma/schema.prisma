generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role      @default(AGENT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads           Lead[]           @relation("assignedLeads")
  activities              Activity[]
  refreshTokens           RefreshToken[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  assignedVehicleListings VehicleListing[] @relation("vehicleListingAssignee")
  reviewedVehicleListings VehicleListing[] @relation("vehicleListingReviewer")
  createdBrokerageDeals   BrokerageDeal[]    @relation("brokerageDealCreator")
  brokerageStageChanges  BrokerageDealStageHistory[]
  approvedCommissions     CommissionAgreement[] @relation("commissionApprover")
  recordedCommissionPayments CommissionPayment[]
  createdVehicleViewings     VehicleViewing[]
  assignedWorkOrders         WorkshopWorkOrder[] @relation("workOrderTechnician")
  createdWorkOrders          WorkshopWorkOrder[] @relation("workOrderCreator")
  inspectionRecords          WorkshopInspectionRecord[]
  recordedWorkshopPayments   WorkshopPayment[]
  createdPartsQuotations     PartsQuotation[]
  uploadedMedia              MediaAsset[]
  createdSparePartListings   SparePartListing[]

  @@index([role])
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model CampaignSource {
  id          String   @id @default(uuid())
  name        String   @unique
  channel     Channel
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]

  @@index([channel])
  @@index([isActive])
}

enum Channel {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  PHONE
  WALK_IN
  REFERRAL
  GOOGLE_ADS
  OTHER
}

model Lead {
  id              String          @id @default(uuid())
  fullName        String
  phone           String
  whatsapp        String?
  email           String?
  city            String?         @default("دمشق")
  age             Int?
  interestedIn    CourseType?
  sourceId        String?
  source          CampaignSource? @relation(fields: [sourceId], references: [id])
  status          LeadStatus      @default(NEW)
  assignedToId    String?
  assignedTo      User?           @relation("assignedLeads", fields: [assignedToId], references: [id])
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notes           String?
  nextFollowUpAt  DateTime?
  lastContactedAt DateTime?
  convertedAt     DateTime?
  lostReason      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  enrollment       Enrollment?
  activities       Activity[]
  consents         ConsentRecord[]
  vehicleInquiries VehicleInquiry[]

  @@index([status])
  @@index([nextFollowUpAt])
  @@index([assignedToId])
  @@index([phone])
  @@index([createdAt])
  @@index([customerId])
}

enum CourseType {
  MECHANICS
  ELECTRICAL
  DIAGNOSTICS
  HYBRID
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  INTERESTED
  FOLLOW_UP
  ENROLLED
  LOST
  NOT_INTERESTED
}

model Enrollment {
  id          String           @id @default(uuid())
  leadId      String           @unique
  lead        Lead             @relation(fields: [leadId], references: [id])
  course      CourseType
  courseId    String?
  courseRef   Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batchId     String?
  batch       CourseBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  totalFee    Decimal          @db.Decimal(10, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(10, 2)
  paymentPlan String?
  startDate   DateTime?
  endDate     DateTime?
  status      EnrollmentStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payments   Payment[]
  attendance Attendance[]

  @@index([status])
  @@index([course])
  @@index([courseId])
  @@index([batchId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Payment {
  id           String        @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  note         String?
  paidAt       DateTime      @default(now())
  recordedById String?
  createdAt    DateTime      @default(now())

  @@index([enrollmentId])
  @@index([paidAt])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  SHAM_CASH
  OTHER
}

model Activity {
  id        String       @id @default(uuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      ActivityType
  content   String
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

enum ActivityType {
  CALL
  WHATSAPP_MSG
  NOTE
  STATUS_CHANGE
  FOLLOW_UP_SET
  ENROLLMENT
  VEHICLE_INQUIRY
}

// Shared identity kept separate from any single business line. Leads,
// enrollments, deals, and work orders reference this record instead of
// duplicating contact data. Records are archived, never hard-deleted.
model Customer {
  id         String    @id @default(uuid())
  fullName   String
  phone      String?
  email      String?
  city       String?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contacts        CustomerContact[]
  leads           Lead[]
  consents        ConsentRecord[]
  vehicleListings VehicleListing[]
  buyerDeals      BrokerageDeal[] @relation("dealBuyer")
  sellerDeals     BrokerageDeal[] @relation("dealSeller")
  workshopRequests WorkshopRequest[]
  partsRequests   PartsRequest[]

  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

enum ContactType {
  PHONE
  EMAIL
  WHATSAPP
  OTHER
}

enum VehicleListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SOLD
  ARCHIVED
}

enum OwnerAuthorizationMethod {
  SIGNED_DOCUMENT
  RECORDED_CALL
  VERIFIED_MESSAGE
  IN_PERSON
}

model VehicleListing {
  id                       String                   @id @default(uuid())
  ownerCustomerId          String
  owner                    Customer                 @relation(fields: [ownerCustomerId], references: [id], onDelete: Restrict)
  assignedToId             String?
  assignedTo               User?                    @relation("vehicleListingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewedById             String?
  reviewedBy               User?                    @relation("vehicleListingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  make                     String
  model                    String
  year                     Int
  mileage                  Int?
  transmission             String?
  fuelType                 String?
  vin                      String?
  city                     String
  description              String?
  askingPrice              Decimal                  @db.Decimal(12, 2)
  currency                 String                   @default("SYP")
  isPriceNegotiable        Boolean                  @default(false)
  conditionVerifiedAt      DateTime?
  inspectionReference      String?
  mediaPaths               String[]                 @default([])
  ownerAuthorizationMethod OwnerAuthorizationMethod
  ownerAuthorizationNote   String
  ownerAuthorizationPath   String?
  ownerAuthorizedAt        DateTime                 @default(now())
  status                   VehicleListingStatus     @default(DRAFT)
  moderationNote           String?
  reviewedAt               DateTime?
  publishedAt              DateTime?
  soldAt                   DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  inquiries VehicleInquiry[]
  brokerageDeals BrokerageDeal[]

  @@index([status, publishedAt])
  @@index([ownerCustomerId])
  @@index([assignedToId])
  @@index([make, model, year])
}

model VehicleInquiry {
  id        String         @id @default(uuid())
  listingId String
  listing   VehicleListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  leadId    String         @unique
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([listingId, createdAt])
}

enum BrokerageDealStatus {
  NEW_INQUIRY
  CONTACTED
  QUALIFIED
  VIEWING_SCHEDULED
  NEGOTIATION
  AGREEMENT_PENDING
  COMPLETED
  LOST
  CANCELLED
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CommissionPayer {
  BUYER
  SELLER
  OTHER
}

enum CommissionCalculationType {
  FIXED
  PERCENTAGE
}

model BrokerageDeal {
  id                    String              @id @default(uuid())
  listingId             String
  listing               VehicleListing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerCustomerId       String
  buyer                 Customer            @relation("dealBuyer", fields: [buyerCustomerId], references: [id], onDelete: Restrict)
  sellerCustomerId      String
  seller                Customer            @relation("dealSeller", fields: [sellerCustomerId], references: [id], onDelete: Restrict)
  createdById           String
  createdBy             User                @relation("brokerageDealCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status                BrokerageDealStatus @default(NEW_INQUIRY)
  expectedAmount        Decimal?             @db.Decimal(12, 2)
  finalAmount           Decimal?             @db.Decimal(12, 2)
  currency              String               @default("SYP")
  outcomeNote           String?
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  history       BrokerageDealStageHistory[]
  viewings      VehicleViewing[]
  commissions   CommissionAgreement[]

  @@index([listingId, status])
  @@index([buyerCustomerId])
  @@index([sellerCustomerId])
  @@index([createdById, status])
  @@index([createdAt])
}

model BrokerageDealStageHistory {
  id        String              @id @default(uuid())
  dealId    String
  deal      BrokerageDeal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  from      BrokerageDealStatus?
  to        BrokerageDealStatus
  reason    String?
  actorId   String?
  actor     User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now())

  @@index([dealId, createdAt])
}

model VehicleViewing {
  id          String        @id @default(uuid())
  dealId      String
  deal        BrokerageDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      ViewingStatus @default(REQUESTED)
  location    String?
  notes       String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([dealId, scheduledAt])
}

model CommissionAgreement {
  id               String                    @id @default(uuid())
  dealId           String
  deal             BrokerageDeal             @relation(fields: [dealId], references: [id], onDelete: Restrict)
  payer            CommissionPayer
  otherPayerName   String?
  calculationType  CommissionCalculationType
  calculationBasis String
  basisAmount      Decimal                   @db.Decimal(12, 2)
  rateOrAmount     Decimal                   @db.Decimal(12, 2)
  amountDue        Decimal                   @db.Decimal(12, 2)
  currency         String                    @default("SYP")
  agreementReference String
  notes            String?
  approvedById     String
  approvedBy       User                      @relation("commissionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  agreedAt         DateTime                  @default(now())
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  payments CommissionPayment[]

  @@unique([dealId, payer])
  @@index([approvedById, agreedAt])
}

model CommissionPayment {
  id            String              @id @default(uuid())
  agreementId   String
  agreement     CommissionAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  amount        Decimal             @db.Decimal(12, 2)
  currency      String
  method        PaymentMethod       @default(CASH)
  reference     String?
  note          String?
  paidAt        DateTime            @default(now())
  recordedById  String
  recordedBy    User                @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())

  @@index([agreementId, paidAt])
}

enum WorkshopRequestStatus {
  NEW
  REVIEWING
  CONFIRMED
  CANCELLED
  RECEIVED
  COMPLETED
}

enum WorkOrderStatus {
  RECEIVED
  DIAGNOSING
  ESTIMATE_PENDING
  AWAITING_CUSTOMER_APPROVAL
  IN_PROGRESS
  QUALITY_CHECK
  DELIVERED
  CANCELLED
}

model WorkshopRequest {
  id               String                @id @default(uuid())
  customerId       String
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleMake      String
  vehicleModel     String
  vehicleYear      Int?
  requestedService String
  reportedSymptoms String?
  preferredAt     DateTime?
  status           WorkshopRequestStatus @default(NEW)
  internalNotes    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  workOrder WorkshopWorkOrder?

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model WorkshopWorkOrder {
  id              String         @id @default(uuid())
  requestId       String         @unique
  request         WorkshopRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  technicianId    String?
  technician      User?          @relation("workOrderTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User           @relation("workOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status          WorkOrderStatus @default(RECEIVED)
  confirmedDiagnosis String?
  estimateAmount  Decimal?       @db.Decimal(12, 2)
  finalAmount     Decimal?       @db.Decimal(12, 2)
  currency        String         @default("SYP")
  customerApprovedAt DateTime?
  customerApprovalReference String?
  completedAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  inspections WorkshopInspectionRecord[]
  payments    WorkshopPayment[]

  @@index([status, createdAt])
  @@index([technicianId, status])
}

model WorkshopInspectionRecord {
  id               String           @id @default(uuid())
  workOrderId      String
  workOrder        WorkshopWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  technicianId     String
  technician       User             @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  checklist        Json
  confirmedFindings String
  recommendations String?
  inspectedAt     DateTime          @default(now())
  createdAt        DateTime          @default(now())

  @@index([workOrderId, inspectedAt])
}

model WorkshopPayment {
  id           String           @id @default(uuid())
  workOrderId  String
  workOrder    WorkshopWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  amount       Decimal          @db.Decimal(12, 2)
  currency     String
  method       PaymentMethod    @default(CASH)
  reference    String?
  paidAt       DateTime         @default(now())
  recordedById String
  recordedBy   User             @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now())

  @@index([workOrderId, paidAt])
}

enum PartsRequestStatus {
  NEW
  REVIEWING
  SOURCING
  QUOTED
  AWAITING_CUSTOMER
  APPROVED
  ORDERED
  FULFILLED
  UNAVAILABLE
  CANCELLED
}

enum SparePartListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SparePartListing {
  id              String                 @id @default(uuid())
  partName        String
  partNumber      String?
  vehicleMake     String?
  vehicleModel    String?
  vehicleYear     Int?
  description     String?
  price           Decimal?               @db.Decimal(12, 2)
  currency        String                 @default("SYP")
  mediaPaths      String[]               @default([])
  status          SparePartListingStatus @default(DRAFT)
  publishedAt     DateTime?
  createdById     String
  createdBy       User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, publishedAt])
  @@index([partName])
  @@index([createdById])
}

enum PartsAvailability {
  UNCONFIRMED
  AVAILABLE
  BACKORDERED
  UNAVAILABLE
}

enum QuoteDecision {
  PENDING
  APPROVED
  REJECTED
}

model PartsRequest {
  id              String            @id @default(uuid())
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleMake     String
  vehicleModel    String
  vehicleYear     Int?
  partName        String
  partNumber      String?
  description     String?
  quantity        Int               @default(1)
  status          PartsRequestStatus @default(NEW)
  customerNotes   String?
  internalNotes   String?
  fulfilledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  quotations PartsQuotation[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model PartsQuotation {
  id                  String            @id @default(uuid())
  requestId           String
  request             PartsRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  supplierName        String
  supplierReference   String?
  quotedPrice         Decimal           @db.Decimal(12, 2)
  currency            String            @default("SYP")
  availability        PartsAvailability @default(UNCONFIRMED)
  estimatedLeadTime   String?
  customerDecision    QuoteDecision     @default(PENDING)
  decisionAt          DateTime?
  validUntil          DateTime?
  createdById         String
  createdBy           User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  customerDecisionReference String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([requestId, createdAt])
  @@index([customerDecision])
}

model CustomerContact {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       ContactType
  value      String
  label      String?
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([customerId, type, value])
  @@index([value])
  @@index([customerId])
}

enum MediaPurpose {
  VEHICLE_IMAGE
  INSTRUCTOR_IMAGE
  SPARE_PART_IMAGE
}

model MediaAsset {
  id          String      @id @default(uuid())
  purpose     MediaPurpose
  mimeType    String
  data        Bytes
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())

  @@index([purpose, createdAt])
  @@index([createdById])
}

model ConsentRecord {
  id         String    @id @default(uuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  purpose    String
  version    String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
  source     String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([leadId])
  @@index([purpose])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  summary    String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String?
  link       String?
  entityType String?
  entityId   String?
  dedupeKey  String?   @unique
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Academy
// ---------------------------------------------------------------------------

model CourseCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@index([isActive])
}

model Instructor {
  id        String   @id @default(uuid())
  fullName  String
  specialty String?
  bio       String?
  phone     String?
  email     String?
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]
  batches CourseBatch[]
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DeliveryMode {
  ONSITE
  ONLINE
  HYBRID
}

model Course {
  id            String          @id @default(uuid())
  slug          String          @unique
  title         String
  shortTitle    String
  courseType    CourseType
  categoryId    String?
  category      CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructorId  String?
  instructor    Instructor?     @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  tagline       String
  summary       String
  description   String[]
  focus         String[]
  prerequisites String[]        @default([])
  format        String
  note          String
  image         String
  imageAlt      String
  deliveryMode  DeliveryMode    @default(ONSITE)
  price         Decimal?        @db.Decimal(12, 2)
  currency      String          @default("SYP")
  featured      Boolean         @default(false)
  sortOrder     Int             @default(0)
  status        CourseStatus    @default(DRAFT)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  batches     CourseBatch[]
  enrollments Enrollment[]

  @@index([status])
  @@index([featured])
  @@index([courseType])
  @@index([categoryId])
}

enum BatchStatus {
  PLANNED
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

model CourseBatch {
  id           String        @id @default(uuid())
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code         String?
  title        String?
  startDate    DateTime?
  endDate      DateTime?
  capacity     Int?
  instructorId String?
  instructor   Instructor?   @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  status       BatchStatus   @default(PLANNED)
  deliveryMode DeliveryMode?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  enrollments Enrollment[]

  @@unique([courseId, code])
  @@index([courseId])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id           String           @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessionDate  DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([enrollmentId, sessionDate])
  @@index([sessionDate])
}
