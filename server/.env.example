NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/academy_crm?schema=public"

# Used only by npm run smoke. Keep this as a separate local test database.
SMOKE_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/academy_crm_test?schema=public"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Public origin of the client app (CORS)
CLIENT_URL="http://localhost:5173"
# Set to true only when the app runs behind a reverse proxy you control
TRUST_PROXY=false

# Optional: used by prisma/seed.ts (SEED_ADMIN_PASSWORD is required when NODE_ENV=production)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Development-only sample leads; never enable in production
SEED_SAMPLE_DATA=false
